{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build charger",
      "type": "shell",
      "command": "make",
      "args": ["all"],
      "options": {
        "cwd": "${workspaceFolder}/SimpleChargerBeta1"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "Clean charger",
      "type": "shell",
      "command": "make",
      "args": ["clean"],
      "options": {
        "cwd": "${workspaceFolder}/SimpleChargerBeta1"
      },
      "problemMatcher": []
    }
  ]
}
