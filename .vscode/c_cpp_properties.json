{
  "configurations": [
    {
      "name": "ATmega328P",
      "includePath": [
        "${workspaceFolder}/SimpleChargerBeta1/shared",
        "${workspaceFolder}/SimpleChargerBeta1/SmeOS/Atmel328p/include",
        "${workspaceFolder}/SimpleChargerBeta1/SmeOS/MidleWare/include"
      ],
      "defines": [
        "F_CPU=16000000UL",
        "__AVR_ATmega328P__"
      ],
      "compilerPath": "avr-g++",
      "compilerArgs": [
        "-mmcu=atmega328p"
      ],
      "cStandard": "c11",
      "cppStandard": "c++98",
      "intelliSenseMode": "gcc-x64"
    }
  ],
  "version": 4
}
